---
/**
 * Servicios presentados como el ciclo de vida real de un sistema de izaje.
 * Cada etapa reúne los servicios que Colcranes efectivamente ofrece
 * (tomados del sitio corporativo) en lugar de repetir tarjetas iguales.
 */
const stages = [
  {
    num: "01",
    name: "Asesoría e ingeniería",
    body:
      "Levantamiento dimensional en planta, definición de luz entre rieles, altura bajo gancho y ciclo de trabajo para calcular el sistema de elevación.",
    refs: ["Asesorías integrales de ingeniería"],
  },
  {
    num: "02",
    name: "Diseño y fabricación",
    body:
      "Fabricación en nuestros talleres de la viga puente, los testeros y la estructura portante a la medida de la nave industrial.",
    refs: ["Fabricación de puentes grúa"],
  },
  {
    num: "03",
    name: "Montaje y puesta en marcha",
    body:
      "Izaje y montaje en sitio, nivelación y alineación topográfica de la vía de rodadura, electrificación y pruebas de carga.",
    refs: ["Montaje y puesta en marcha de grúas"],
  },
  {
    num: "04",
    name: "Servicio y garantía",
    body:
      "Soporte técnico directo posterior a la entrega, atención de garantías en planta y ajustes operativos sobre los equipos instalados.",
    refs: ["Servicios técnicos", "Servicio de garantías"],
  },
  {
    num: "05",
    name: "Operación y mantenimiento",
    body:
      "Planes de mantenimiento preventivo, inspecciones estructurales y electromecánicas, y pólizas anuales con suministro de repuestos.",
    refs: ["Mantenimiento preventivo", "Contratos de mantenimiento y repuestos"],
  },
  {
    num: "06",
    name: "Reposición y accesorios",
    body:
      "Despacho de repuestos originales de fábrica, cables de acero, controles remotos y accesorios de izaje bajo gancho.",
    refs: [
      "Suministro de repuestos",
      "Accesorios de elevación bajo gancho",
    ],
  },
  {
    num: "07",
    name: "Modernización",
    body:
      "Actualización eléctrica, cambio de polipastos, conversión a radiocontrol y repotenciación de grúas existentes en operación.",
    refs: ["Modernización de puente grúa"],
  },
];
---

<section class="lifecycle band" id="ciclo">
  <div class="wrap">
    <header class="sec-head sec-head--split lifecycle__head">
      <div>
        <p class="eyebrow eyebrow--light" data-reveal>Servicios</p>
        <h2 class="d2" style="margin-top:1.25rem;color:#fff" data-reveal>
          Ingeniería, montaje y<br />mantenimiento de grúas
        </h2>
      </div>
      <div data-reveal>
        <p class="lede lede--light">
          Acompañamos toda la vida operativa de su sistema de elevación: desde el levantamiento
          en planta y la fabricación estructural hasta el mantenimiento preventivo, el suministro
          de repuestos originales y la modernización del equipo.
        </p>
      </div>
    </header>

    <div class="rail" data-rail>
      <span class="rail__line" aria-hidden="true"></span>
      <span class="rail__node-line" data-rail-line aria-hidden="true"></span>

      <ul class="rail__stops">
        {stages.map((stage, index) => (
          <li class={`stop ${index === 0 ? "is-active" : ""}`}>
            <span class="stop__dot" aria-hidden="true"></span>
            <button class="stop__toggle" type="button" aria-pressed={index === 0 ? "true" : "false"}>
              <span class="stop__num">{stage.num}</span>
              <span class="stop__name">{stage.name}</span>
            </button>
            <p class="stop__body">{stage.body}</p>
            <ul class="stop__refs">
              {stage.refs.map((ref) => <li>{ref}</li>)}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
