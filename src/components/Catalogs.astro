---
/**
 * Catálogo vigente: vista previa ancha del PDF y acciones de descarga.
 */
import { PROMO_IMAGES } from "../data/promos";
import { responsiveImage } from "../utils/media";

const catalogUrl = "/catalogos/colcranes-catalogo-2023.pdf";
const backdrop = PROMO_IMAGES[7] ?? "/images/planta-bodega.webp";
const viewerUrl = `${catalogUrl}#page=1&zoom=78,0,0&toolbar=0&navpanes=0`;
---

<section class="catalogs" id="catalogos">
  <div class="catalogs__media" aria-hidden="true">
    <img src={backdrop} {...await responsiveImage(backdrop)} alt="" loading="lazy" decoding="async" />
  </div>
  <div class="catalogs__hook" aria-hidden="true">
    <img src="/images/assets/gancho.webp" alt="" width="1365" height="768" loading="lazy" decoding="async" />
  </div>

  <div class="wrap catalogs__grid">
    <figure class="catalogs__viewer">
      <div class="catalogs__frame">
        <div class="catalogs__mobile-pdf" data-mobile-pdf data-url={catalogUrl}>
          <div class="catalogs__pdf-controls">
            <button type="button" data-pdf-prev aria-label="Página anterior" disabled>←</button>
            <span data-pdf-status role="status">Cargando catálogo…</span>
            <button type="button" data-pdf-next aria-label="Página siguiente" disabled>→</button>
          </div>
          <div class="catalogs__pdf-page" data-pdf-page aria-label="Página del catálogo"></div>
          <a class="catalogs__pdf-fallback" href={catalogUrl} target="_blank" rel="noopener noreferrer">Abrir PDF completo</a>
        </div>
        <iframe
          src={viewerUrl}
          data-catalog-viewer
          data-src={catalogUrl}
          title="Catálogo Colcranes 2023"
          loading="lazy"
        ></iframe>
      </div>
    </figure>

    <div class="catalogs__lead">
      <h2 class="d2 catalogs__title">La línea completa, en un solo catálogo.</h2>
      <p class="lede catalogs__lede">
        Puentes grúa, pórticos, grúas bandera y polipastos. Capacidades, configuraciones y alcance de servicio.
      </p>

      <div class="catalogs__actions">
        <a class="btn btn--signal" href={catalogUrl} download>
          Descargar catálogo
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path d="M12 3v12M6 11l6 6 6-6M4 21h16" />
          </svg>
        </a>
        <a class="link-arrow link-arrow--light" href={catalogUrl} target="_blank" rel="noopener noreferrer">
          Ver catálogo
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .catalogs__mobile-pdf { display: none; }
  @media (max-width: 999px) {
    .catalogs__frame iframe { display: none; }
    .catalogs__mobile-pdf { display: flex; flex-direction: column; height: clamp(26rem, 110vw, 42rem); background: var(--paper); color: var(--ink); }
    .catalogs__pdf-controls { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding: 0.5rem; font-size: 0.85rem; border-bottom: 1px solid var(--line-dark); }
    .catalogs__pdf-controls button { flex: 0 0 44px; height: 44px; border: 1px solid var(--line-dark); background: transparent; color: var(--navy); font-size: 1.25rem; cursor: pointer; }
    .catalogs__pdf-controls button:disabled { opacity: 0.35; cursor: default; }
    .catalogs__pdf-page { flex: 1; min-height: 0; overflow: auto; }
    .catalogs__pdf-page :global(canvas) { display: block; width: 100%; height: auto; }
    .catalogs__pdf-fallback { display: grid; place-items: center; min-height: 44px; font-size: 0.8rem; text-decoration: underline; }
  }
  .catalogs__hook {
    position: absolute;
    top: -4rem;
    right: 13%;
    width: clamp(8rem, 15vw, 14rem);
    height: clamp(13rem, 23vw, 20rem);
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    filter: drop-shadow(0 8px 8px rgb(8 12 45 / 28%));
  }

  .catalogs__hook img {
    position: absolute;
    left: 50%;
    height: 100%;
    width: auto;
    max-width: none;
    transform: translateX(-50%);
  }

  @media (max-width: 979px) {
    .catalogs__hook {
      top: -3rem;
      right: 8%;
      width: 7rem;
      height: 11.5rem;
    }
  }

  .catalogs__title {
    color: #edf3fa;
    background: linear-gradient(
      180deg,
      #ffffff 0%,
      #f4f7fb 25%,
      #b9c6d8 48%,
      #e5edf7 53%,
      #ffffff 72%,
      #b5c3d7 100%
    );
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    -webkit-text-stroke: 0.5px rgb(255 255 255 / 35%);
    filter: drop-shadow(0 2px 0 #1b2054)
      drop-shadow(0 4px 0 #171b49)
      drop-shadow(0 8px 10px rgb(8 12 45 / 45%));
  }
</style>

<script>
  import workerUrl from "pdfjs-dist/build/pdf.worker.min.mjs?url";

  document.querySelectorAll<HTMLElement>("[data-mobile-pdf]").forEach((viewer) => {
    const media = window.matchMedia("(max-width: 999px)");
    let started = false;
    const start = async () => {
      if (started || !media.matches) return;
      started = true;
      const status = viewer.querySelector<HTMLElement>("[data-pdf-status]")!;
      const host = viewer.querySelector<HTMLElement>("[data-pdf-page]")!;
      const prev = viewer.querySelector<HTMLButtonElement>("[data-pdf-prev]")!;
      const next = viewer.querySelector<HTMLButtonElement>("[data-pdf-next]")!;
      try {
        const pdfjs = await import("pdfjs-dist");
        pdfjs.GlobalWorkerOptions.workerSrc = workerUrl;
        const pdf = await pdfjs.getDocument({ url: viewer.dataset.url! }).promise;
        let pageNumber = 1;
        let revision = 0;
        const render = async () => {
          const current = ++revision;
          const number = pageNumber;
          prev.disabled = number <= 1;
          next.disabled = number >= pdf.numPages;
          status.textContent = `Página ${number} de ${pdf.numPages}`;
          host.setAttribute("aria-busy", "true");
          try {
            const page = await pdf.getPage(number);
            const width = host.clientWidth;
            if (!width) return;
            const scale = width / page.getViewport({ scale: 1 }).width;
            const viewport = page.getViewport({ scale: scale * Math.min(window.devicePixelRatio || 1, 2) });
            const canvas = document.createElement("canvas");
            canvas.width = Math.ceil(viewport.width);
            canvas.height = Math.ceil(viewport.height);
            canvas.setAttribute("role", "img");
            canvas.setAttribute("aria-label", `Catálogo Colcranes, página ${number}. Para consultar el documento accesible use Abrir PDF completo.`);
            await page.render({ canvas, viewport }).promise;
            if (current !== revision) return;
            host.replaceChildren(canvas);
            host.scrollTop = 0;
          } catch {
            if (current === revision) status.textContent = "No se pudo mostrar la página. Abra el PDF completo.";
          } finally {
            if (current === revision) host.setAttribute("aria-busy", "false");
          }
        };
        prev.addEventListener("click", () => { if (pageNumber > 1) { pageNumber--; void render(); } });
        next.addEventListener("click", () => { if (pageNumber < pdf.numPages) { pageNumber++; void render(); } });
        let lastWidth = 0;
        new ResizeObserver(() => {
          if (host.clientWidth && host.clientWidth !== lastWidth) {
            lastWidth = host.clientWidth;
            void render();
          }
        }).observe(host);
      } catch (error) {
        console.error("No se pudo cargar el catálogo", error);
        status.textContent = "No se pudo cargar la vista previa. Abra el PDF completo.";
      }
    };
    const observer = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) void start();
    }, { rootMargin: "300px" });
    observer.observe(viewer);
    media.addEventListener("change", () => {
      if (viewer.getBoundingClientRect().top < window.innerHeight + 300) void start();
    });
  });
</script>
