---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "COLCRANES | Fabricación, montaje y mantenimiento de puentes grúa y polipastos en Colombia",
  description =
    "Colcranes S.A.S. diseña, fabrica, monta y mantiene puentes grúa, pórticos, grúas bandera y polipastos en Colombia. Más de 25 años de experiencia y 800 proyectos desde Barranquilla y Bogotá.",
} = Astro.props;

const site = "https://colcranes.com";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="COLCRANES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${site}/images/hero-crane.jpg`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,300..900;1,62..125,600..800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        "@id": `${site}/#organization`,
        name: "COLCRANES S.A.S.",
        url: site,
        logo: `${site}/images/colcranes-logo-oscura.png`,
        description,
        email: "comercial@colcranes.com",
        telephone: "+57 315 629 3396",
        address: [
          {
            "@type": "PostalAddress",
            streetAddress: "Cra. 67 # Vía 40-62, piso 3",
            addressLocality: "Barranquilla",
            addressCountry: "CO",
          },
          {
            "@type": "PostalAddress",
            streetAddress: "Cra. 128 # 14B-31",
            addressLocality: "Bogotá",
            addressCountry: "CO",
          },
        ],
        contactPoint: [
          {
            "@type": "ContactPoint",
            telephone: "+57-315-629-3396",
            contactType: "sales",
            areaServed: "CO",
            availableLanguage: "es",
          },
          {
            "@type": "ContactPoint",
            telephone: "+57-310-704-3333",
            contactType: "technical support",
            areaServed: "CO",
            availableLanguage: "es",
          },
          {
            "@type": "ContactPoint",
            telephone: "+57-322-249-2904",
            contactType: "customer service",
            areaServed: "CO",
            availableLanguage: "es",
          },
        ],
        sameAs: [
          "https://co.linkedin.com/company/colcranes-s-a-s",
          "https://www.instagram.com/colcranes_sas/",
          "https://www.facebook.com/Colcranespuentegruasypolipastos",
          "https://twitter.com/colcranes",
        ],
        areaServed: "Colombia",
      })}
    />
  </head>

  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido principal</a>
    <slot />

    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
