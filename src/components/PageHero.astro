---
interface Props {
  image: string;
  tone?: "black" | "blue" | "white";
}

const { image, tone = "black" } = Astro.props;
---

<section class={`page-hero interior-hero interior-hero--${tone}`}>
  <img class="interior-hero__image" src={image} alt="" loading="eager" fetchpriority="high" decoding="async" />
  <div class="interior-hero__overlay" aria-hidden="true"></div>
  <slot />
</section>

<style>
  .interior-hero {
    isolation: isolate;
    background: #17191d;
    padding-top: clamp(6.5rem, 9vw, 8rem);
    padding-bottom: clamp(2.5rem, 4.5vw, 4rem);
  }

  .interior-hero__image,
  .interior-hero__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }

  .interior-hero__image { object-fit: cover; object-position: center; }
  .interior-hero__overlay {
    background: linear-gradient(90deg, rgb(0 0 0 / 88%), rgb(0 0 0 / 67%));
  }

  .interior-hero--blue { background: var(--navy); }
  .interior-hero--blue .interior-hero__overlay {
    background: linear-gradient(90deg, rgb(25 27 83 / 94%), rgb(45 46 131 / 72%));
  }

  .interior-hero :global(.d1) { font-size: clamp(2.5rem, 6vw, 5.25rem); }

  .interior-hero--white { background: #fff; color: var(--ink); }
  .interior-hero--white .interior-hero__overlay {
    background: linear-gradient(90deg, rgb(255 255 255 / 96%), rgb(255 255 255 / 78%));
  }
  .interior-hero--white :global(.lede--light) { color: var(--steel-500); }
  .interior-hero--white :global(.breadcrumbs) { color: var(--steel-500); }
  .interior-hero--white :global(.breadcrumbs span),
  .interior-hero--white :global(.breadcrumbs a:hover) { color: var(--navy); }
</style>
