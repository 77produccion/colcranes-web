---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Quote from "../../components/Quote.astro";
import Footer from "../../components/Footer.astro";
import { EQUIPMENT_FAMILIES } from "../../data/site";
---

<Layout
  title="Equipos de Izaje Industrial: Puentes Grúa, Pórticos y Polipastos | COLCRANES"
  description="Catálogo de equipos de izaje industrial en Colombia: puentes grúa monoviga y biviga, grúas pórtico, grúas bandera, polipastos de cable y cadena, kits y electrificación."
>
  <Header />
  <main id="contenido">
    <section class="page-hero">
      <div class="wrap">
        <nav class="breadcrumbs" aria-label="Ruta de navegación">
          <a href="/">Inicio</a>
          <span>/</span>
          <span aria-current="page">Equipos</span>
        </nav>
        <p class="eyebrow eyebrow--light">Catálogo de maquinaria y componentes</p>
        <h1 class="d1" style="margin-top:0.75rem;max-width:18ch">
          Equipos para izaje industrial
        </h1>
        <p class="lede lede--light" style="margin-top:1.25rem;max-width:62ch">
          Diseñamos y fabricamos puentes grúa, pórticos y grúas bandera en nuestra planta de 3.000 m²,
          e integramos polipastos, kits y sistemas de electrificación de fabricantes líderes.
        </p>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <div class="catalog-cards">
          {EQUIPMENT_FAMILIES.map((family) => (
            <article class="catalog-card">
              <div class="catalog-card__media catalog-card__media--contain">
                <img src={family.image} alt={family.alt} loading="lazy" decoding="async" />
              </div>
              <p class="mono" style="margin:0;color:var(--navy);font-weight:700">{family.num} · {family.short}</p>
              <h2 class="d3" style="margin:0.4rem 0 0">{family.pluralName}</h2>
              <p class="body-copy" style="margin-top:0.75rem;flex:1">{family.copy}</p>
              <div style="margin-top:1.25rem;padding-top:1rem;border-top:1px solid var(--line-dark);display:flex;justify-content:space-between;align-items:center">
                <a class="link-arrow" href={`/equipos/${family.slug}`}>
                  Ver especificaciones
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M5 12h14M13 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <Quote />
  </main>
  <Footer />
</Layout>
