# Ignorar archivos mayores a 5MB en docs


# Extensiones pesadas de video y diseño en docs/
*.mp4
*.mov
*.avi
*.mkv
*.wmv
*.zip
*.rar
*.7z
*.psd
*.ai

# Clips optimizados del hero sí se publican (pesan pocos MB y son parte del sitio)
!public/videos/hero/*.mp4

# Los originales se archivan fuera de public; sólo se versionan derivados web.
public/images/proyecto-1/*.[jJ][pP][gG]
public/videos/videos-proyecto-1/
public/catalogos/Brochure*.pdf
