---
/**
 * Firmas representadas y línea propia (Punto 1).
 * - Se mantienen: R&M, Worldhoists, Diepa, SRP, Black Bear, Autec.
 * - Se agrega: CMAK.
 * - NOVALIFT es línea propia y va sin enlace externo.
 * - Se retiraron Felemamg, Conductix y Drivecon hasta confirmación.
 * - Si el archivo de logo existe en `public/`, renderiza el `<img>`; si está pendiente de entrega,
 *   deja el espacio reservado para el logo oficial monocromo (sin inventar SVGs).
 */
import { existsSync } from "node:fs";
import { BRANDS } from "../data/site";

const brandsWithStatus = BRANDS.map((brand) => ({
  ...brand,
  hasFile: existsSync(`public${brand.img}`),
}));
---

<section class="brands" aria-label="Marcas representadas y línea propia">
  <div class="wrap">
    <h2 class="brands__label">Marcas aliadas y línea propia</h2>
    <ul class="brands__row">
      {brandsWithStatus.map((brand) => (
        <li class="brands__item">
          {brand.url ? (
            <a
              class="brands__link"
              href={brand.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Visitar sitio oficial de ${brand.name}`}
              data-tooltip={brand.name}
            >
              {brand.hasFile ? (
                <img src={brand.img} alt={brand.name} loading="lazy" decoding="async" />
              ) : (
                <span class="logo-slot" aria-label={`Espacio para logo oficial de ${brand.shortName}`}>
                  <span class="logo-slot__name">{brand.shortName}</span>
                  <span class="logo-slot__hint">Logo PNG/SVG</span>
                </span>
              )}
              <span class="brands__tooltip" aria-hidden="true">{brand.name}</span>
            </a>
          ) : (
            <div
              class="brands__link brands__link--static"
              aria-label={brand.name}
              data-tooltip={brand.name}
            >
              {brand.hasFile ? (
                <img src={brand.img} alt={brand.name} loading="lazy" decoding="async" />
              ) : (
                <span class="logo-slot logo-slot--own" aria-label={`Espacio para logo de ${brand.shortName}`}>
                  <span class="logo-slot__name">{brand.shortName}</span>
                  <span class="logo-slot__hint">Sin enlace · Logo PNG/SVG</span>
                </span>
              )}
              <span class="brands__tooltip" aria-hidden="true">{brand.name}</span>
            </div>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>
