---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import PageHero from "../../components/PageHero.astro";
import { PROMO_IMAGES } from "../../data/promos";
import Brands from "../../components/Brands.astro";
import Quote from "../../components/Quote.astro";
import Footer from "../../components/Footer.astro";
import { EQUIPMENT_FAMILIES, HOIST_OPTIONS, type EquipmentFamily } from "../../data/site";
import { responsiveImage } from "../../utils/media";

export function getStaticPaths() {
  return EQUIPMENT_FAMILIES.map((family) => ({
    params: { slug: family.slug },
    props: { family },
  }));
}

interface Props {
  family: EquipmentFamily;
}

const { family } = Astro.props;
const otherFamilies = EQUIPMENT_FAMILIES.filter((item) => item.slug !== family.slug);
const heroImages = [0, 7, 5, 10, 3, 4];
const familyIndex = EQUIPMENT_FAMILIES.findIndex((item) => item.slug === family.slug);
const heroImage = PROMO_IMAGES[heroImages[familyIndex]] ?? "/images/planta-bodega.webp";
---

<Layout title={family.seoTitle} description={family.seoDescription}>
  <Header />
  <main id="contenido">
    <PageHero image={heroImage} tone="black">
      <div class="wrap">
        <nav class="breadcrumbs" aria-label="Ruta de navegación">
          <a href="/">Inicio</a>
          <span>/</span>
          <a href="/equipos">Equipos</a>
          <span>/</span>
          <span aria-current="page">{family.name}</span>
        </nav>
        <h1 class="d1" style="margin-top:0.75rem;max-width:18ch">
          {family.pluralName}
        </h1>
        <p class="lede lede--light" style="margin-top:1.25rem;max-width:62ch">
          {family.copy}
        </p>
        <div class="hero__ctas" style="margin-top:1.75rem">
          <button class="btn btn--signal" type="button" data-quote-open>
            Cotizar {family.name.toLowerCase()}
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path d="M5 12h14M13 5l7 7-7 7" />
            </svg>
          </button>
          <a class="btn btn--ghost-light" href="/equipos">Ver todo el catálogo</a>
        </div>
      </div>
    </PageHero>

    <section class="band">
      <div class="wrap">
        <div class="detail-layout">
          <div>
            <div class="detail-media">
              <img src={family.image} {...await responsiveImage(family.image, "(min-width: 960px) 50vw, 92vw")} alt={family.alt} loading="lazy" decoding="async" />
            </div>

            {family.slug === "polipastos" && (
              <div style="margin-top:2rem">
                <h2 class="d3" style="margin-bottom:1rem">Líneas de polipastos disponibles</h2>
                <div class="hoist-range" aria-label="Opciones de polipastos">
                  {HOIST_OPTIONS.map((option) => (
                    <article class="hoist-option">
                      <div class="hoist-option__image">
                        <img src={option.image} alt={option.alt} loading="lazy" decoding="async" />
                      </div>
                      <div class="hoist-option__copy">
                        <h3>{option.name}</h3>
                        <p>{option.detail}</p>
                      </div>
                    </article>
                  ))}
                </div>
              </div>
            )}

            <div class="body-copy" style="margin-top:2rem">
              <h2 class="d3" style="margin-bottom:1rem">Ingeniería y configuración</h2>
              {family.longDescription.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </div>

          <div>
            <dl class="spec-grid" style="margin-bottom:2rem">
              {family.specs.map((spec) => (
                <div>
                  <dt>{spec.label}</dt>
                  <dd>{spec.value}</dd>
                </div>
              ))}
            </dl>

            <div style="background:var(--steel-100);border:1px solid var(--line-dark);border-top:3px solid var(--navy);padding:1.5rem;margin-bottom:1.75rem">
              <h2 class="d3">Características técnicas</h2>
              <ul class="check-list">
                {family.features.map((feat) => <li>{feat}</li>)}
              </ul>
            </div>

            <div style="background:var(--paper);border:1px solid var(--line-dark);padding:1.5rem">
              <h2 class="d3">Aplicaciones habituales</h2>
              <ul class="check-list">
                {family.applications.map((app) => <li>{app}</li>)}
              </ul>
              <div style="margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid var(--line-dark)">
                <button class="btn btn--ink" type="button" data-quote-open style="width:100%;justify-content:center">
                  Solicitar dimensionamiento y cotización
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <Brands />

    <section class="band" style="background:var(--steel-100);border-top:1px solid var(--line-dark)">
      <div class="wrap">
        <header class="sec-head">
          <div>
            <p class="eyebrow">Otras familias del catálogo</p>
            <h2 class="d2" style="margin-top:0.75rem">Más equipos de izaje</h2>
          </div>
        </header>
        <div class="catalog-cards">
          {otherFamilies.map(async (item) => (
            <article>
              <a class="related-equipment" href={`/equipos/${item.slug}`}>
                <img class="related-equipment__image" src={item.image} {...await responsiveImage(item.image, "(min-width: 960px) 30vw, 92vw")} alt="" loading="lazy" decoding="async" />
                <div class="related-equipment__content">
                  <h3 class="d3">{item.pluralName}</h3>
                  <svg class="related-equipment__arrow" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M4 12h15M12 5l7 7-7 7" />
                  </svg>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <Quote />
  </main>
  <Footer />
</Layout>

<style>
  .related-equipment {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 20rem;
    height: 100%;
    overflow: hidden;
    background: var(--steel-100);
    color: #fff;
    text-decoration: none;
    isolation: isolate;
  }

  .related-equipment__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    opacity: 0.92;
    filter: grayscale(0.4) brightness(0.72);
    transform: scale(1);
    transition: transform 0.85s var(--ease-out), opacity 0.6s var(--ease-out), filter 0.85s var(--ease-out);
  }

  .related-equipment:is(:hover, :focus-visible, :active) .related-equipment__image {
    opacity: 1;
    filter: grayscale(0) brightness(1);
    transform: scale(1.04);
  }

  .related-equipment::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / 12%) 20%, rgb(0 0 0 / 85%) 100%);
    z-index: -1;
  }

  .related-equipment__content {
    display: flex;
    align-items: flex-end;
    gap: 1rem;
    width: 100%;
    padding: 1.5rem;
  }

  .related-equipment h3 { flex: 1; margin: 0; color: inherit; }

  .related-equipment__arrow {
    flex-shrink: 0;
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .related-equipment:is(:hover, :focus-visible, :active) .related-equipment__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .related-equipment:focus-visible {
    outline: 3px solid var(--cyan);
    outline-offset: 4px;
  }

  @media (hover: none) {
    .related-equipment__arrow { opacity: 1; transform: none; }
  }
</style>
