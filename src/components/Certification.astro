---
import IsoLogo from "./IsoLogo.astro";
---

<section class="certification" aria-labelledby="certification-title">
  <div class="wrap certification__inner">
    <IsoLogo />
    <div class="certification__copy">
      <h2 id="certification-title">Ahora certificados en <span>ISO 45001</span></h2>
      <p>Una certificación de nuestro sistema de gestión de seguridad y salud en el trabajo.</p>
    </div>
  </div>
</section>

<style>
  .certification { padding-block: clamp(1.75rem, 3vw, 2.5rem); border-block: 1px solid var(--line-dark); background: var(--steel-100); color: var(--ink); }
  .certification__inner { display: flex; align-items: center; gap: clamp(1.25rem, 3vw, 3rem); }
  .certification__copy { min-width: 0; }
  .certification h2 { margin: 0; font-family: var(--font-display); font-size: clamp(1.35rem, 2.2vw, 2rem); font-weight: 700; line-height: 1.2; }
  .certification h2 span { white-space: nowrap; }
  .certification p { max-width: 65ch; margin: 0.6rem 0 0; font-size: clamp(0.9375rem, 1.15vw, 1.125rem); line-height: 1.55; }
</style>
