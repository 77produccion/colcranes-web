---
/**
 * Capacidad, planta y compañía.
 * Los valores de la tabla de datos están tomados del sitio corporativo
 * (ver CONTENT_AUDIT_COLCRANES.md). No se publican cifras sin respaldo.
 */
const capabilities = [
  {
    num: "01",
    title: "Fabricación propia",
    text: "Fabricamos estructuras de puentes grúa y otros componentes; también suministramos equipos y piezas de fabricantes especializados.",
  },
  {
    num: "02",
    title: "Ingeniería de cálculo",
    text: "El cálculo considera la luz entre rieles, la altura disponible, la carga y el régimen de trabajo.",
  },
  {
    num: "03",
    title: "Montaje en planta",
    text: "Realizamos la instalación, alineación de la vía de rodadura y pruebas de funcionamiento en planta.",
  },
  {
    num: "04",
    title: "Cobertura nacional",
    text: "Tenemos sedes en Barranquilla y Bogotá y atendemos proyectos en distintas regiones de Colombia.",
  },
];

const showcase = [
  {
    num: "01",
    title: "Proyectos",
    text: "Puentes grúa, pórticos y grúas bandera para planta nueva o ampliación.",
    img: "/images/galeria/montaje-equipo.webp",
    alt: "Equipo de izaje y estructura amarilla dispuestos para montaje en patio",
  },
  {
    num: "02",
    title: "Servicios",
    text: "Mantenimiento, montaje y puesta en marcha de equipos en operación.",
    img: "/images/galeria/servicio-tecnico.webp",
    alt: "Técnicos revisando el gancho de un polipasto de 55 toneladas",
  },
  {
    num: "03",
    title: "Repuestos y polipastos",
    text: "Repuestos de cable, tambores, guías y polipastos de cadena y cable.",
    img: "/images/galeria/ingenieria-calculo.webp",
    alt: "Medición del diámetro de un cable de acero con un calibrador",
  },
  {
    num: "04",
    title: "Fabricación",
    text: "Estructuras, testeros y componentes fabricados y controlados en taller.",
    img: "/images/galeria/fabricacion-taller.webp",
    alt: "Técnico ajustando un reductor sobre una viga en el taller de fabricación",
  },
];

const companyData = [
  { label: "Trayectoria", value: "+25 años", src: "colcranes.com" },
  { label: "Proyectos entregados", value: "+800", src: "colcranes.com" },
  { label: "Sedes", value: "Barranquilla · Bogotá", src: "colcranes.com" },
  { label: "Atención", value: "Lun–Vie 07:30–17:30", src: "colcranes.com" },
  { label: "Actividad", value: "Fabricación, montaje, mantenimiento", src: "colcranes.com" },
];
---

<section class="capacity band" id="capacidad">
  <div class="wrap">
    <header class="sec-head sec-head--split">
      <div>
        <h2 class="d2" style="margin-top:1.25rem" data-reveal>
          Ingeniería y fabricación<br />en Colombia
        </h2>
      </div>
      <div data-reveal>
        <p class="lede">
          Diseñamos, fabricamos e instalamos sistemas de izaje. También ofrecemos mantenimiento y repuestos para equipos en operación.
        </p>
      </div>
    </header>

    <div class="plate" data-reveal-group>
      <figure class="plate__main" data-reveal>
        <img
          src="/images/planta-bodega.webp"
          alt="Puente grúa amarillo instalado sobre su vía de rodadura en una bodega de acero en operación"
          width="1800"
          height="1108"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="figcap">
          Puente grúa en operación sobre vía de rodadura · bodega de lámina de acero
        </figcaption>
      </figure>

      <figure class="plate__secondary" data-reveal>
        <img
          src="/images/planta-puente-marca.webp"
          alt="Puente grúa Colcranes rotulado en su vía de rodadura dentro de una bodega industrial"
          width="1200"
          height="892"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="figcap">Puente grúa rotulado · izaje de servicio en planta</figcaption>
      </figure>
    </div>

    <div class="capacity__intro">
      <div class="capabilities" data-reveal-group>
        {capabilities.map((item) => (
          <article class="capability" data-reveal>
            <div class="capability__top">
              <span class="capability__num">{item.num}</span>
              <span class="capability__rule" aria-hidden="true"></span>
            </div>
            <h3 class="d3">{item.title}</h3>
            <p class="body-copy">{item.text}</p>
          </article>
        ))}
      </div>

      {/* Oculto temporalmente: Datos de la compañía y nota técnica
      <div data-reveal>
        <table class="data-table">
          <caption>Datos de la compañía · fuente: sitio corporativo</caption>
          <tbody>
            {companyData.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td class="data-table__value">{row.value}</td>
                <td class="data-table__src">{row.src}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="note-src">
          La capacidad máxima por familia se confirma con el levantamiento en planta. Los rangos
          publicados en la sección de equipos corresponden a proyectos documentados en el archivo
          técnico de Colcranes.
        </p>
      </div>
      */}
    </div>
  </div>

  <div class="wrap" style="margin-top:clamp(2.5rem,5vw,4.5rem)">
    <header class="sec-head sec-head--split" style="margin-bottom:clamp(1.5rem,3vw,2.5rem)">
      <div>
        <h2 class="d3" style="margin-top:1rem" data-reveal>Cotiza con nosotros</h2>
      </div>
      <div data-reveal>
        <p class="lede">
          Dinos qué necesitas cotizar: un equipo nuevo, un servicio, un repuesto o una fabricación a medida.
        </p>
      </div>
    </header>

    <div class="showcase" data-reveal-group>
      {showcase.map((panel) => (
        <article class="showcase__item" data-reveal tabindex="0">
          <img
            class="showcase__img"
            src={panel.img}
            alt={panel.alt}
            width="1600"
            height="2133"
            loading="lazy"
            decoding="async"
          />
          <span class="showcase__shade" aria-hidden="true"></span>
          <span class="showcase__num">{panel.num}</span>
          <div class="showcase__body">
            <h3 class="d3">{panel.title}</h3>
            <p class="body-copy">{panel.text}</p>
            <button type="button" class="showcase__cta">Cotizar</button>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
