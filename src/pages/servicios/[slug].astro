---
import { existsSync } from "node:fs";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import PageHero from "../../components/PageHero.astro";
import Quote from "../../components/Quote.astro";
import Footer from "../../components/Footer.astro";
import { SERVICES, CONTACT, type ServiceItem } from "../../data/site";
import { PROMO_IMAGES } from "../../data/promos";
import { responsiveImage } from "../../utils/media";

export function getStaticPaths() {
  return SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;
const hasImage = existsSync(`public${service.image}`);
const otherServices = SERVICES.filter((item) => item.slug !== service.slug);
const serviceIndex = SERVICES.findIndex((item) => item.slug === service.slug);
const heroImage = PROMO_IMAGES[serviceIndex % PROMO_IMAGES.length] ?? service.image;
---

<Layout title={service.seoTitle} description={service.seoDescription}>
  <Header />
  <main id="contenido">
    <PageHero image={heroImage} tone="blue">
      <div class="wrap">
        <nav class="breadcrumbs" aria-label="Ruta de navegación">
          <a href="/">Inicio</a>
          <span>/</span>
          <a href="/servicios">Servicios</a>
          <span>/</span>
          <span aria-current="page">{service.shortTitle}</span>
        </nav>
        <h1 class="d1" style="margin-top:0.75rem;max-width:19ch">
          {service.name}
        </h1>
        <p class="lede lede--light" style="margin-top:1.25rem;max-width:62ch">
          {service.body}
        </p>
        <div class="hero__ctas" style="margin-top:1.75rem">
          <button class="btn btn--signal" type="button" data-quote-open>
            Solicitar este servicio
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path d="M5 12h14M13 5l7 7-7 7" />
            </svg>
          </button>
          <a class="btn btn--ghost-light" href={CONTACT.whatsappUrl}>Contactar soporte por WhatsApp</a>
          {['mantenimiento-preventivo', 'contratos-mantenimiento-repuestos', 'servicios-tecnicos'].includes(service.slug) && (
            <a class="btn btn--ghost-light" href="/estimador">Estimar costo del servicio</a>
          )}
        </div>
      </div>
    </PageHero>

    <section class="band">
      <div class="wrap">
        <div class="detail-layout">
          <div>
            <div class="detail-media" style="padding:0;overflow:hidden">
              {hasImage ? (
                <img
                  src={service.image}
                  {...await responsiveImage(service.image, "(min-width: 960px) 50vw, 92vw")}
                  alt={service.alt}
                  style="max-height:28rem;object-fit:cover;width:100%"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="media-slot media-slot--detail" role="img" aria-label={`Espacio para fotografía del servicio ${service.name}`}>
                  <span class="media-slot__tag">ESPACIO PARA FOTOGRAFÍA · SERVICIO {service.num}</span>
                  <span class="media-slot__title">{service.name}</span>
                  <span class="media-slot__meta">{service.slotSpec}</span>
                  <code class="media-slot__path">{service.image}</code>
                </div>
              )}
            </div>

            <div class="body-copy" style="margin-top:2rem">
              <h2 class="d3" style="margin-bottom:1rem">Descripción del servicio</h2>
              {service.longDescription.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </div>

          <div>
            <div style="background:var(--steel-100);border:1px solid var(--line-dark);border-top:3px solid var(--navy);padding:1.75rem;margin-bottom:1.75rem">
              <h2 class="d3">Alcance y entregables</h2>
              <ul class="check-list">
                {service.deliverables.map((item) => <li>{item}</li>)}
              </ul>
              <div style="margin-top:1.75rem;padding-top:1.25rem;border-top:1px solid var(--line-dark)">
                <button class="btn btn--ink" type="button" data-quote-open style="width:100%;justify-content:center">
                  Programar visita o cotización
                </button>
              </div>
            </div>

            <div style="background:var(--paper);border:1px solid var(--line-dark);padding:1.5rem">
              <p class="mono" style="margin:0;color:var(--navy);font-weight:700">Atención directa</p>
              <h3 class="d4" style="margin:0.4rem 0 0">Líneas de ingeniería y soporte</h3>
              <p class="body-copy" style="margin-top:0.5rem;font-size:0.92rem">
                Ventas y proyectos: <a href={CONTACT.salesPhoneHref} style="font-weight:700;color:var(--navy)">{CONTACT.salesPhone}</a><br />
                Soporte técnico: <a href={CONTACT.supportPhoneHref} style="font-weight:700;color:var(--navy)">{CONTACT.supportPhone}</a><br />
                Servicio al cliente: <a href={CONTACT.customerServicePhone1Href} style="font-weight:700;color:var(--navy)">{CONTACT.customerServicePhone1}</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="band" style="background:var(--steel-100);border-top:1px solid var(--line-dark)">
      <div class="wrap">
        <header class="sec-head">
          <div>
            <p class="eyebrow">Portafolio de servicios</p>
            <h2 class="d2" style="margin-top:0.75rem">Otros servicios especializados</h2>
          </div>
        </header>
        <div class="catalog-cards">
          {otherServices.slice(0, 6).map(async (item) => (
            <article>
              <a class="related-service" href={`/servicios/${item.slug}`}>
                <img class="related-service__image" src={item.image} {...await responsiveImage(item.image, "(min-width: 960px) 30vw, 92vw")} alt="" loading="lazy" decoding="async" />
                <div class="related-service__content">
                  <h3 class="d3">{item.name}</h3>
                  <svg class="related-service__arrow" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M4 12h15M12 5l7 7-7 7" />
                  </svg>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <Quote />
  </main>
  <Footer />
</Layout>

<style>
  .related-service {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 20rem;
    height: 100%;
    overflow: hidden;
    background: var(--ink);
    color: #fff;
    text-decoration: none;
    isolation: isolate;
  }

  .related-service__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    opacity: 0.92;
    filter: grayscale(0.4) brightness(0.72);
    transform: scale(1);
    transition: transform 0.85s var(--ease-out), opacity 0.6s var(--ease-out), filter 0.85s var(--ease-out);
  }

  .related-service:is(:hover, :focus-visible, :active) .related-service__image {
    opacity: 1;
    filter: grayscale(0) brightness(1);
    transform: scale(1.04);
  }

  .related-service::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / 12%) 20%, rgb(0 0 0 / 85%) 100%);
    z-index: -1;
  }

  .related-service__content {
    display: flex;
    align-items: flex-end;
    gap: 1rem;
    width: 100%;
    padding: 1.5rem;
  }

  .related-service h3 {
    flex: 1;
    margin: 0;
    color: inherit;
  }

  .related-service__arrow {
    flex-shrink: 0;
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .related-service:is(:hover, :focus-visible, :active) .related-service__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .related-service:focus-visible {
    outline: 3px solid var(--cyan);
    outline-offset: 4px;
  }

  @media (hover: none) {
    .related-service__arrow {
      opacity: 1;
      transform: none;
    }
  }

</style>
