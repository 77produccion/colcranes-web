---
/**
 * Capacidad, planta y compañía.
 * Usa exclusivamente fotografía real de Colcranes (cero banco de imágenes / cero IA).
 */
const capabilities = [
  {
    num: "01",
    title: "Fabricación propia",
    text: "Fabricamos estructuras de puentes grúa, testeros y componentes en nuestra planta de 3.000 m²; también integramos equipos de fabricantes especializados.",
  },
  {
    num: "02",
    title: "Ingeniería de cálculo",
    text: "El cálculo estructural bajo normas CMAA y FEM considera la luz entre rieles, la altura disponible, la carga nominal y el régimen de trabajo.",
  },
  {
    num: "03",
    title: "Montaje en planta",
    text: "Realizamos la instalación con personal técnico propio, alineación de la vía de rodadura y pruebas de funcionamiento con carga en sitio.",
  },
  {
    num: "04",
    title: "Cobertura nacional",
    text: "Operamos desde nuestras sedes en Barranquilla y Bogotá, desplazando cuadrillas técnicas a plantas industriales de toda Colombia.",
  },
];

const showcase = [
  {
    num: "01",
    title: "Proyectos",
    text: "Puentes grúa, pórticos y grúas bandera para planta nueva o ampliación.",
    img: "/images/galeria/montaje-equipo.webp",
    alt: "Equipo de izaje y estructura amarilla dispuestos para montaje en patio",
  },
  {
    num: "02",
    title: "Servicios",
    text: "Mantenimiento, montaje y puesta en marcha de equipos en operación.",
    img: "/images/galeria/servicio-tecnico.webp",
    alt: "Técnicos revisando el gancho de un polipasto de 55 toneladas",
  },
  {
    num: "03",
    title: "Repuestos y polipastos",
    text: "Repuestos de cable, tambores, guías y polipastos de cadena y cable.",
    img: "/images/galeria/ingenieria-calculo.webp",
    alt: "Medición del diámetro de un cable de acero con un calibrador",
  },
  {
    num: "04",
    title: "Fabricación",
    text: "Estructuras, testeros y componentes fabricados y controlados en taller.",
    img: "/images/galeria/fabricacion-taller.webp",
    alt: "Técnico ajustando un reductor sobre una viga en el taller de fabricación",
  },
];
---

<section class="capacity" id="capacidad">
  <div class="capacity__stage">
    <img
      class="capacity__bg"
      src="/images/planta-bodega.webp"
      alt="Dos puentes grúa Colcranes de 2,5 toneladas en operación dentro de una planta industrial"
      width="1672"
      height="941"
      loading="lazy"
      decoding="async"
    />
    <div class="wrap capacity__stage-inner">
      <header class="sec-head sec-head--split capacity__head">
        <div>
          <p class="eyebrow eyebrow--light" data-reveal>Nosotros y capacidad operativa</p>
          <h2 class="d2" style="margin-top:1.25rem" data-reveal>
            Ingeniería y fabricación<br />en Colombia
          </h2>
        </div>
        <div data-reveal>
          <p class="lede lede--light">
            Diseñamos, fabricamos e instalamos sistemas de izaje. También ofrecemos mantenimiento, modernización y repuestos para equipos en operación.
          </p>
          <div style="margin-top:1.25rem">
            <a class="link-arrow link-arrow--light" href="/nosotros">
              Conocer más sobre Colcranes y nuestra planta
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14M13 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </header>
    </div>
  </div>

  <div class="wrap capacity__cards">
    <div class="capabilities" data-reveal-group>
      {capabilities.map((item) => (
        <article class="capability" data-reveal>
          <div class="capability__top">
            <span class="capability__num">{item.num}</span>
            <span class="capability__rule" aria-hidden="true"></span>
          </div>
          <h3 class="d3">{item.title}</h3>
          <p class="body-copy">{item.text}</p>
        </article>
      ))}
    </div>
  </div>

  <div class="wrap capacity__quote">
    <header class="sec-head sec-head--split" style="margin-bottom:clamp(1.5rem,3vw,2.5rem)">
      <div>
        <h2 class="d3" style="margin-top:1rem" data-reveal>Cotiza con nosotros</h2>
      </div>
      <div data-reveal>
        <p class="lede">
          Dinos qué necesitas cotizar: un equipo nuevo, un servicio, un repuesto o una fabricación a medida.
        </p>
      </div>
    </header>

    <div class="showcase" data-reveal-group>
      {showcase.map((panel) => (
        <article class="showcase__item" data-reveal tabindex="0">
          <img
            class="showcase__img"
            src={panel.img}
            alt={panel.alt}
            width="1600"
            height="2133"
            loading="lazy"
            decoding="async"
          />
          <span class="showcase__shade" aria-hidden="true"></span>
          <span class="showcase__num">{panel.num}</span>
          <div class="showcase__body">
            <h3 class="d3">{panel.title}</h3>
            <p class="body-copy">{panel.text}</p>
            <button type="button" class="showcase__cta" data-quote-open>Cotizar</button>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
