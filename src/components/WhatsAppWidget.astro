---
/**
 * Acceso flotante a WhatsApp con selección de línea de atención.
 * Deja eventos `whatsapp_open` y `whatsapp_lead` en `dataLayer`
 * (y en `gtag` si está disponible) para medir leads.
 */
import { CONTACT } from "../data/site";

const waPath =
  "M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z";

const lines = [
  {
    label: "Comercial y cotizaciones",
    detail: "Barranquilla · Bogotá",
    number: CONTACT.salesPhone,
    wa: CONTACT.whatsappNumber,
    message: "Hola Colcranes, quiero solicitar una cotización.",
  },
  {
    label: "Soporte técnico",
    detail: "Atención en planta",
    number: CONTACT.supportPhone,
    wa: "573107043333",
    message: "Hola Colcranes, necesito soporte técnico para un equipo.",
  },
  {
    label: "Servicio al cliente",
    detail: "Pedidos y repuestos",
    number: CONTACT.customerServicePhone1,
    wa: "573222492904",
    message: "Hola Colcranes, necesito atención al cliente.",
  },
];
---

<div class="wa-widget" data-wa>
  <button
    class="wa-fab"
    type="button"
    data-wa-open
    aria-haspopup="dialog"
    aria-controls="wa-dialog"
    aria-expanded="false"
    aria-label="Abrir líneas de atención por WhatsApp"
    data-track="whatsapp_open"
  >
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d={waPath} />
    </svg>
  </button>

  <div class="wa-modal" id="wa-dialog" role="dialog" aria-modal="true" aria-labelledby="wa-title" hidden data-wa-modal>
    <div class="wa-modal__scrim" data-wa-close></div>

    <div class="wa-modal__panel" role="document">
      <button class="wa-modal__close" type="button" data-wa-close aria-label="Cerrar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>

      <p class="eyebrow">Atención directa</p>
      <h2 id="wa-title" class="d3">¿Con qué línea desea hablar?</h2>
      <p class="wa-modal__intro">
        Elija el equipo que necesita. Le respondemos por WhatsApp en horario hábil.
      </p>

      <ul class="wa-lines">
        {lines.map((line) => (
          <li>
            <a
              class="wa-line"
              href={`https://wa.me/${line.wa}?text=${encodeURIComponent(line.message)}`}
              target="_blank"
              rel="noopener noreferrer"
              data-wa-line={line.label}
            >
              <span class="wa-line__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d={waPath} />
                </svg>
              </span>
              <span class="wa-line__body">
                <span class="wa-line__label">{line.label}</span>
                <span class="wa-line__detail">{line.detail}</span>
              </span>
              <span class="wa-line__number">{line.number}</span>
            </a>
          </li>
        ))}
      </ul>

      <p class="wa-modal__note">{CONTACT.schedule}</p>
    </div>
  </div>
</div>
