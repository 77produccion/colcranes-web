---
import '../styles/global.css';
import '../styles/fonts.css';
import { SITE_URL, CONTACT } from '../data/site';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';
import PageTransition from '../components/PageTransition.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  preloadImage?: { src: string; srcset?: string; sizes?: string };
}

const {
  title = "COLCRANES | Fabricación, montaje y mantenimiento de puentes grúa y polipastos en Colombia",
  description =
    "Colcranes S.A.S. diseña, fabrica, monta y mantiene puentes grúa, pórticos, grúas bandera y polipastos en Colombia. Más de 25 años de experiencia y 800 proyectos desde Barranquilla y Bogotá.",
  ogImage = `${SITE_URL}/images/og-colcranes.jpg`,
  preloadImage,
} = Astro.props;

const canonicalPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonicalUrl = new URL(canonicalPath, SITE_URL).toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage.src} imagesrcset={preloadImage.srcset} imagesizes={preloadImage.sizes} fetchpriority="high" />}
    <script is:inline>
      (() => {
        const key = "colcranes:page-transition";
        try {
          const pending = JSON.parse(sessionStorage.getItem(key) || "null");
          sessionStorage.removeItem(key);
          if (pending && pending.path === location.pathname + location.search && Date.now() - pending.time < 15000) {
            document.documentElement.classList.add("is-page-entering");
            // Never leave the page covered if the animation module fails to load.
            window.setTimeout(() => {
              document.documentElement.classList.remove("is-page-entering");
              document.documentElement.removeAttribute("aria-busy");
            }, 4000);
          }
        } catch { /* Storage is optional; normal navigation remains available. */ }
      })();
    </script>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#2D2E83" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="COLCRANES" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="COLCRANES · Equipos para izaje industrial en Colombia" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href="/fonts/saira-normal-600-900-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/barlow-normal-400-latin.woff2" as="font" type="font/woff2" crossorigin />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        "@id": `${SITE_URL}/#organization`,
        name: CONTACT.companyName,
        url: SITE_URL,
        logo: `${SITE_URL}/images/colcranes-logo-oscura.webp`,
        image: ogImage,
        description,
        email: CONTACT.commercialEmail,
        telephone: CONTACT.salesPhone,
        address: [
          {
            "@type": "PostalAddress",
            streetAddress: "Cra. 67 # Vía 40-62, piso 3",
            addressLocality: "Barranquilla",
            addressCountry: "CO",
          },
          {
            "@type": "PostalAddress",
            streetAddress: "Cra. 128 # 14B-31",
            addressLocality: "Bogotá",
            addressCountry: "CO",
          },
        ],
        contactPoint: [
          {
            "@type": "ContactPoint",
            telephone: "+57-315-629-3396",
            contactType: "sales",
            areaServed: "CO",
            availableLanguage: "es",
          },
          {
            "@type": "ContactPoint",
            telephone: "+57-310-704-3333",
            contactType: "technical support",
            areaServed: "CO",
            availableLanguage: "es",
          },
          {
            "@type": "ContactPoint",
            telephone: "+57-322-249-2904",
            contactType: "customer service",
            areaServed: "CO",
            availableLanguage: "es",
          },
        ],
        sameAs: CONTACT.socials.map((s) => s.href),
        areaServed: "Colombia",
      })}
    />
  </head>

  <body>
    <PageTransition />
    <a class="skip-link" href="#contenido">Saltar al contenido principal</a>
    <slot />

    <WhatsAppWidget />

    <script>
      // Let the critical HTML/CSS paint before downloading and initializing motion.
      let motionReady: Promise<unknown> | undefined;
      const loadMotion = () => motionReady ??= import('../scripts/motion.ts');
      // Early interactions on slow networks must not be lost while the module loads.
      document.addEventListener('click', (event) => {
        if (document.documentElement.classList.contains('js')) return;
        const control = event.target instanceof Element
          ? event.target.closest<HTMLElement>('[data-drawer-toggle], [data-quote-open], [data-wa-open], a[href="#cotizar"]') : null;
        if (!control) return;
        event.preventDefault();
        event.stopImmediatePropagation();
        void loadMotion().then(() => control.click());
      }, { capture: true });
      requestAnimationFrame(() => requestAnimationFrame(() => {
        void loadMotion();
      }));
    </script>
  </body>
</html>
