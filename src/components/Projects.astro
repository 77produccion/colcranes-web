---
/**
 * Proyectos.
 * El registro se construye con las fichas técnicas del archivo de ingeniería
 * (códigos FT). No se publican capacidades, clientes ni resultados que no
 * estén respaldados por ese archivo.
 */
/* Extracto del archivo de fichas técnicas (209 archivos). Cada fila se
   corresponde con un código real; la capacidad se transcribe del nombre de la
   ficha y sólo se publica cuando allí está declarada. FT-1079 aparece en el
   archivo para dos clientes distintos, así que la fila de Triple A usa FT-1081,
   que no es ambiguo. */
const registry = [
  { ref: "FT-110201", client: "Reservado", equip: "Puente grúa", cap: "15 t" },
  { ref: "FT-110202", client: "Reservado", equip: "Puente grúa", cap: "12,8 t" },
  { ref: "FT-110203", client: "Reservado", equip: "Puente grúa", cap: "3 t y 5 t" },
  { ref: "FT-110205", client: "Reservado", equip: "Puente grúa", cap: "12,5 t" },
  { ref: "FT-107102", client: "Reservado", equip: "Semipórtico", cap: "17 t" },
  { ref: "FT-107101", client: "Reservado", equip: "Semipórtico", cap: "5 t" },
  { ref: "FT-107103", client: "Reservado", equip: "Puente grúa", cap: "5 t" },
  { ref: "FT-1110", client: "Reservado", equip: "Puente grúa monoviga", cap: "3 t" },
  { ref: "FT-107001", client: "Reservado", equip: "Puente grúa", cap: "2,5 t" },
  { ref: "FT-107002", client: "Reservado", equip: "Monorriel curvo", cap: "2 t" },
  { ref: "FT-108301", client: "Reservado", equip: "Puente grúa", cap: "3 t" },
  { ref: "FT-108302", client: "Reservado", equip: "Puente grúa", cap: "5 t" },
  { ref: "FT-108303", client: "Reservado", equip: "Pórtico", cap: "2 t" },
  { ref: "FT-108304", client: "Reservado", equip: "Puente colgante", cap: "3 t" },
  { ref: "FT-109201", client: "Reservado", equip: "Puente grúa", cap: "1 t y 2 t" },
  { ref: "FT-1112", client: "Reservado", equip: "Puente grúa · polipasto", cap: "5 t" },
  { ref: "FT-1080", client: "Reservado", equip: "Modificación de pórtico", cap: "Intervención" },
  { ref: "FT-1081", client: "Reservado", equip: "Modernización de puente grúa", cap: "Intervención" },
  { ref: "FT-1077", client: "Reservado", equip: "Extensión de vía de rodadura", cap: "Obra civil y mecánica" },
  { ref: "FT-1078", client: "Reservado", equip: "Equipo de izaje a medida", cap: "Documentado" },
];
---

<section class="projects band" id="proyectos">
  <div class="wrap">
    <header class="sec-head sec-head--split">
      <div>
        <h2 class="d2" style="margin-top:1.25rem" data-reveal>
          Proyectos documentados
        </h2>
      </div>
      <div data-reveal>
        <p class="lede">
          Extracto del registro técnico de proyectos. Los nombres de clientes se omiten mientras se confirma su autorización de publicación.
        </p>
      </div>
    </header>

    <div class="registry__scroll" data-reveal>
      <table class="registry">
        <caption class="vh">Registro de proyectos documentados</caption>
        <thead>
          <tr>
            <th scope="col">Referencia</th>
            <th scope="col">Cliente · instalación</th>
            <th scope="col">Equipo o intervención</th>
            <th scope="col" style="text-align:right">Capacidad</th>
          </tr>
        </thead>
        <tbody>
          {registry.map((row) => (
            <tr>
              <td class="ref">{row.ref}</td>
              <td class="client">{row.client}</td>
              <td class="equip">{row.equip}</td>
              <td class="cap">{row.cap}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="note-src">
      Extracto del archivo de fichas técnicas de ingeniería. Las capacidades se transcriben de la
      ficha cuando están declaradas; los nombres de clientes no se muestran mientras se confirma
      su autorización de publicación.
    </p>
  </div>
</section>
