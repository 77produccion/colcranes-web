---
import { existsSync } from "node:fs";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Quote from "../../components/Quote.astro";
import Footer from "../../components/Footer.astro";
import { SERVICES } from "../../data/site";

const servicesWithStatus = SERVICES.map((service) => ({
  ...service,
  hasImage: existsSync(`public${service.image}`),
}));
---

<Layout
  title="Servicios de Ingeniería, Fabricación, Montaje y Mantenimiento de Grúas | COLCRANES"
  description="Servicios especializados de Colcranes S.A.S. en Colombia: fabricación de puentes grúa, montaje, mantenimiento preventivo, contratos, repuestos, modernización y asesoría técnica."
>
  <Header />
  <main id="contenido">
    <section class="page-hero">
      <div class="wrap">
        <nav class="breadcrumbs" aria-label="Ruta de navegación">
          <a href="/">Inicio</a>
          <span>/</span>
          <span aria-current="page">Servicios</span>
        </nav>
        <p class="eyebrow eyebrow--light">Soporte durante todo el ciclo operativo</p>
        <h1 class="d1" style="margin-top:0.75rem;max-width:18ch">
          Nuestros servicios de ingeniería e izaje
        </h1>
        <p class="lede lede--light" style="margin-top:1.25rem;max-width:62ch">
          Acompañamos cada etapa de sus equipos de elevación con ingenieros y técnicos propios desde Barranquilla y Bogotá para toda Colombia.
        </p>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <div class="catalog-cards">
          {servicesWithStatus.map((service) => (
            <article class="catalog-card">
              <div class="catalog-card__media">
                {service.hasImage ? (
                  <img src={service.image} alt={service.alt} loading="lazy" decoding="async" />
                ) : (
                  <div class="media-slot media-slot--card" role="img" aria-label={`Espacio para fotografía del servicio ${service.name}`}>
                    <span class="media-slot__tag">ESPACIO PARA FOTO · SERVICIO {service.num}</span>
                    <span class="media-slot__meta">{service.slotSpec}</span>
                    <code class="media-slot__path">{service.image}</code>
                  </div>
                )}
              </div>
              <p class="mono" style="margin:0;color:var(--navy);font-weight:700">Servicio {service.num}</p>
              <h2 class="d3" style="margin:0.4rem 0 0">{service.name}</h2>
              <p class="body-copy" style="margin-top:0.75rem;flex:1">{service.body}</p>
              <div style="margin-top:1.25rem;padding-top:1rem;border-top:1px solid var(--line-dark);display:flex;justify-content:space-between;align-items:center">
                <a class="link-arrow" href={`/servicios/${service.slug}`}>
                  Ver alcance del servicio
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M5 12h14M13 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <Quote />
  </main>
  <Footer />
</Layout>
