---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Brands from "../components/Brands.astro";
import Stats from "../components/Stats.astro";
import MachineExplorer from "../components/MachineExplorer.astro";
import Lifecycle from "../components/Lifecycle.astro";
import Projects from "../components/Projects.astro";
import Clients from "../components/Clients.astro";
import Capacity from "../components/Capacity.astro";
import Quote from "../components/Quote.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="COLCRANES | Fabricación, montaje y mantenimiento de puentes grúa y polipastos en Colombia"
  description="Colcranes S.A.S. diseña, fabrica, monta y mantiene puentes grúa, pórticos, grúas bandera y polipastos en Colombia. Más de 25 años de trayectoria y 800 proyectos desde Barranquilla y Bogotá."
>
  <span
    data-header-sentinel
    aria-hidden="true"
    style="position:absolute;top:0;left:0;height:88px;width:1px"
  ></span>
  <Header />
  <main id="contenido">
    <Hero />
    <Brands />
    <Stats />
    <MachineExplorer />
    <Lifecycle />
    <Projects />
    <Clients />
    <Capacity />
    <Quote />
  </main>
  <Footer />
</Layout>
