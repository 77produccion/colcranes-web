---
/**
 * Servicios (Lifecycle).
 * - Los 10 servicios tienen cada uno su propio espacio de fotografía (sin repetir las mismas 3)
 *   y SIN filtro morado.
 * - Cuando se coloca el archivo correspondiente en `public/images/servicios/`, se renderiza la foto automáticamente.
 * - Cada tarjeta enlaza a su página individual de servicio (/servicios/[slug]) para SEO.
 */
import { existsSync } from "node:fs";
import { SERVICES } from "../data/site";

const servicesWithStatus = SERVICES.map((service) => ({
  ...service,
  hasImage: existsSync(`public${service.image}`),
}));
---

<section class="lifecycle band" id="ciclo">
  <div class="wrap">
    <header class="services-head">
      <p class="eyebrow eyebrow--light" data-reveal>Soporte durante todo el ciclo operativo</p>
      <h2 class="d2" style="margin-top:1rem" data-reveal>Nuestros servicios</h2>
      <p class="lede lede--light services-head__description" data-reveal>
        Soporte técnico, fabricación, montaje, modernización y repuestos para cada etapa de sus equipos de izaje.
      </p>
    </header>
    <div class="services-list">
      {servicesWithStatus.map((service) => (
        <a class="service-line" href={`/servicios/${service.slug}`}>
          {service.hasImage ? (
            <img
              class="service-line__img"
              src={service.image}
              alt={service.alt}
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div class="media-slot media-slot--service" aria-hidden="true">
              <span class="media-slot__tag">ESPACIO PARA FOTO · SERVICIO {service.num}</span>
              <span class="media-slot__meta">{service.slotSpec}</span>
              <code class="media-slot__path">{service.image}</code>
            </div>
          )}
          <span class="service-line__shade" aria-hidden="true"></span>
          <span class="service-line__num">{service.num}</span>
          <div class="service-line__content">
            <h3>{service.name}</h3>
            <p>{service.body}</p>
            <span class="service-line__cta">
              Ver servicio
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <path d="M5 12h14M13 5l7 7-7 7" />
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
