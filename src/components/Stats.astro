---
/**
 * Sección de cifras de respaldo (Punto 4.2):
 * Proyectos ejecutados, años de experiencia, técnicos propios y sedes.
 */
import { COMPANY_STATS } from "../data/site";
---

<section class="stats-band" aria-label="Cifras de respaldo de Colcranes">
  <div class="stats-band__art" aria-hidden="true">
    <img
      class="stats-band__crane"
      src="/images/assets/stats-hoist.webp"
      alt=""
      width="732"
      height="735"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="wrap">
    <div class="stats-grid" data-reveal-group>
      {COMPANY_STATS.map((stat) => (
        <article class="stat-card" data-reveal>
          <p class="stat-card__value">{stat.value}</p>
          <h2 class="stat-card__label">{stat.label}</h2>
          <p class="stat-card__detail">{stat.detail}</p>
        </article>
      ))}
    </div>
  </div>
</section>
