---
/**
 * Explorador de maquinaria (Equipos).
 * Pestañas con radios nativos + enlace directo a cada página individual SEO (/equipos/[slug]).
 */
import { EQUIPMENT_FAMILIES, HOIST_OPTIONS } from "../data/site";

const families = EQUIPMENT_FAMILIES;
const hoistOptions = HOIST_OPTIONS;

const tabRules = families
  .map(
    (family) => `
.explorer__grid #${family.id}:checked ~ .stage-holder #${family.id}-panel { display: block; }
.explorer__grid #${family.id}:checked ~ .index-list label[for="${family.id}"] { color: var(--ink); padding-left: 1.6rem; }
.explorer__grid #${family.id}:checked ~ .index-list label[for="${family.id}"] .index-row__num { color: var(--signal-deep); }
.explorer__grid #${family.id}:focus-visible ~ .index-list label[for="${family.id}"] { outline: 3px solid var(--cyan); outline-offset: 2px; }`
  )
  .join("");
---

<section class="explorer band" id="equipos">
  <div class="wrap">
    <header class="sec-head explorer__head">
      <div>
        <p class="eyebrow" data-reveal>Catálogo de equipos</p>
        <h2 class="d2 explorer__title" style="margin-top:1rem" data-reveal>
          Nuestros productos
        </h2>
        <p class="lede">
          <span class="explorer__experience">Más de 25 años de experiencia</span>
          <span class="explorer__description">
            Fabricamos equipos de izaje y suministramos componentes de fabricantes especializados.
            Definimos cada solución según la carga, la luz entre rieles, la altura y las condiciones de la planta.
          </span>
        </p>
      </div>
    </header>

    <div class="explorer__grid" data-explorer>
      {families.map((family, index) => (
        <input
          type="radio"
          name="familia-colcranes"
          id={family.id}
          checked={index === 0}
          aria-label={`${family.num} ${family.name} — ${family.short}`}
        />
      ))}

      <div class="index-list">
        <span class="index-list__rail" aria-hidden="true"></span>
        <span class="index-list__marker" data-marker aria-hidden="true"></span>
        {families.map((family) => (
          <label class="index-row" for={family.id}>
            <span class="index-row__num">{family.num}</span>
            <span class="index-row__name">
              {family.name}
              <span
                style="display:block;font-family:var(--font-mono);font-size:.66rem;letter-spacing:.1em;text-transform:uppercase;font-weight:500;color:var(--steel-500);margin-top:.35rem"
              >
                {family.short}
              </span>
            </span>
          </label>
        ))}
      </div>

      <div class="stage-holder">
        {families.map((family, index) => (
          <div
            class={`family ${index === 0 ? "is-active" : ""}`}
            id={`${family.id}-panel`}
            role="tabpanel"
            aria-label={family.name}
          >
            <div class="stage">
              {family.id !== "fam-cable" && (
                <div class="stage__media">
                  <figure class={`stage__fig ${index === 0 ? "is-active" : ""} ${family.photo ? "is-photo" : ""}`}>
                    <img src={family.image} alt={family.alt} loading="lazy" decoding="async" />
                    {family.notes.map((note) => (
                      <span class={`note note--${note.pos}`}>{note.text}</span>
                    ))}
                  </figure>
                </div>
              )}

              {family.id === "fam-cable" && (
                <div class="hoist-range" aria-label="Opciones de polipastos">
                  {hoistOptions.map((option) => (
                    <article class="hoist-option">
                      <div class="hoist-option__image">
                        <img src={option.image} alt={option.alt} loading="lazy" decoding="async" />
                      </div>
                      <div class="hoist-option__copy">
                        <h3>{option.name}</h3>
                        <p>{option.detail}</p>
                      </div>
                    </article>
                  ))}
                </div>
              )}

              <div class="stage__foot">
                <div>
                  <p class="body-copy">{family.copy}</p>
                  <div style="display:flex;flex-wrap:wrap;gap:.4rem .75rem;margin-top:1rem">
                    {family.tags.map((tag) => (
                      <span class="mono" style="color:var(--steel-500)">{tag}</span>
                    ))}
                  </div>
                  <div style="display:flex;flex-wrap:wrap;gap:1rem;align-items:center;margin-top:1.25rem">
                    <a class="link-arrow" href={`/equipos/${family.slug}`}>
                      Ver página de {family.name}
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M5 12h14M13 5l7 7-7 7" />
                      </svg>
                    </a>
                  </div>
                </div>
                <dl class="spec-grid">
                  {family.specs.map((spec) => (
                    <div>
                      <dt>{spec.label}</dt>
                      <dd>{spec.value}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <style is:global set:html={tabRules}></style>
</section>
