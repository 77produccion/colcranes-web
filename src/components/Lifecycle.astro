---
/**
 * Servicios presentados como el ciclo de vida real de un sistema de izaje.
 * Cada etapa reúne los servicios que Colcranes efectivamente ofrece
 * (tomados del sitio corporativo) en lugar de repetir tarjetas iguales.
 */
const services = [
  { name: "Montaje y puesta en marcha de grúa", body: "Instalamos el equipo, alineamos la vía de rodadura y verificamos su funcionamiento antes de entrar en operación." },
  { name: "Mantenimiento preventivo", body: "Inspecciones y tareas programadas para detectar desgaste y mantener los equipos disponibles." },
  { name: "Contratos de mantenimiento y repuestos", body: "Planes de atención que reúnen mantenimiento y suministro de componentes para las necesidades de cada planta." },
  { name: "Suministro de repuestos", body: "Componentes para reparación y reposición de equipos de izaje." },
  { name: "Accesorios de elevación bajo gancho", body: "Accesorios seleccionados según la carga y la maniobra requerida." },
  { name: "Fabricación de puentes grúa", body: "Diseño y fabricación de equipos según la luz, capacidad, altura de izaje y condiciones de la nave." },
  { name: "Modernización de puente grúa", body: "Actualización de sistemas y componentes tras revisar el estado y los requerimientos del equipo." },
  { name: "Servicios técnicos", body: "Soporte especializado para revisión, diagnóstico y atención de equipos de izaje." },
  { name: "Servicio de garantías", body: "Atención y seguimiento de garantías para equipos suministrados por Colcranes." },
  { name: "Asesorías integrales de ingeniería", body: "Acompañamiento técnico para definir soluciones de izaje desde los requerimientos de operación." },
];
---

<section class="lifecycle band" id="ciclo">
  <div class="wrap">
    <header class="services-head">
      <h2 class="d2" data-reveal>Nuestros servicios</h2>
      <p class="lede lede--light services-head__description" data-reveal>Soporte técnico y soluciones para cada etapa de sus equipos de izaje.</p>
    </header>
    <div class="services-list">
      {services.map((service, index) => (
        <article class="service-line" tabindex="0">
          <h3>{service.name}</h3>
          <p>{service.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
