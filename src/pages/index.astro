---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Brands from "../components/Brands.astro";
import MachineExplorer from "../components/MachineExplorer.astro";
import Lifecycle from "../components/Lifecycle.astro";
import Capacity from "../components/Capacity.astro";
import Projects from "../components/Projects.astro";
import Quote from "../components/Quote.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="COLCRANES | Fabricación, montaje y mantenimiento de puentes grúa y polipastos"
  description="Colcranes fabrica, monta, mantiene y moderniza puentes grúa, pórticos, grúas bandera y polipastos para la industria colombiana. Más de 25 años y más de 800 proyectos."
>
  <span
    data-header-sentinel
    aria-hidden="true"
    style="position:absolute;top:0;left:0;height:88px;width:1px"
  ></span>
  <Header />
  <main id="contenido">
    <Hero />
    <Brands />
    <MachineExplorer />
    <Lifecycle />
    <Capacity />
    <Projects />
    <Quote />
  </main>
  <Footer />
</Layout>
