---
/**
 * Capacidad, planta y compañía.
 * Los valores de la tabla de datos están tomados del sitio corporativo
 * (ver CONTENT_AUDIT_COLCRANES.md). No se publican cifras sin respaldo.
 */
const capabilities = [
  {
    num: "01",
    title: "Fabricación propia",
    text: "Construimos en nuestros talleres las vigas cajón, los testeros y las estructuras portantes con acero certificado y procesos de soldadura controlada.",
  },
  {
    num: "02",
    title: "Ingeniería de cálculo",
    text: "Dimensionamos cada puente grúa con la luz real entre rieles, la altura bajo gancho disponible, las cargas sobre la nave y la frecuencia de operación.",
  },
  {
    num: "03",
    title: "Montaje en planta",
    text: "Desplegamos cuadrillas propias para el izaje de vigas, la nivelación de la vía de rodadura, la electrificación longitudinal y las pruebas de carga en sitio.",
  },
  {
    num: "04",
    title: "Cobertura nacional",
    text: "Operamos desde nuestras sedes de Barranquilla y Bogotá con desplazamiento de ingenieros y técnicos a plantas industriales en todo el país.",
  },
];

const companyData = [
  { label: "Trayectoria", value: "+25 años", src: "Ingeniería y fabricación en Colombia" },
  { label: "Proyectos entregados", value: "+800", src: "Siderurgia, manufactura, minería y puertos" },
  { label: "Sedes", value: "Barranquilla · Bogotá", src: "Planta costa Caribe y sede centro" },
  { label: "Horario de planta", value: "Lun a Vie 07:30 a 17:30", src: "Soporte técnico y atención comercial" },
  { label: "Alcance operativo", value: "Diseño, fabricación, montaje y servicio", src: "Cobertura nacional" },
];
---

<section class="capacity band" id="capacidad">
  <div class="wrap">
    <header class="sec-head sec-head--split">
      <div>
        <p class="eyebrow" data-reveal>Capacidad y planta</p>
        <h2 class="d2" style="margin-top:1.25rem" data-reveal>
          Fabricación propia y<br />montaje en toda Colombia
        </h2>
      </div>
      <div data-reveal>
        <p class="lede">
          Integramos bajo una misma dirección técnica el cálculo estructural, la fabricación en
          taller, el montaje en sitio y el mantenimiento posventa. Así respondemos directamente por
          la estructura, los mecanismos de izaje y la continuidad operativa del equipo.
        </p>
      </div>
    </header>

    <div class="plate" data-reveal-group>
      <figure class="plate__main" data-reveal>
        <img
          src="/images/planta-bodega.webp"
          alt="Puente grúa amarillo instalado sobre su vía de rodadura en una bodega de acero en operación"
          width="1800"
          height="1108"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="figcap">
          Puente grúa en operación sobre vía de rodadura · bodega de lámina de acero
        </figcaption>
      </figure>

      <figure class="plate__secondary" data-reveal>
        <img
          src="/images/planta-puente-marca.webp"
          alt="Puente grúa Colcranes rotulado en su vía de rodadura dentro de una bodega industrial"
          width="1200"
          height="892"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="figcap">Puente grúa rotulado · izaje de servicio en planta</figcaption>
      </figure>
    </div>

    <div class="capacity__intro">
      <div class="capabilities" data-reveal-group>
        {capabilities.map((item) => (
          <article class="capability" data-reveal>
            <span class="capability__num">{item.num}</span>
            <div>
              <h3 class="d3">{item.title}</h3>
              <p class="body-copy">{item.text}</p>
            </div>
          </article>
        ))}
      </div>

      <div data-reveal>
        <table class="data-table">
          <caption>Ficha operativa de Colcranes S.A.S.</caption>
          <tbody>
            {companyData.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td class="data-table__value">{row.value}</td>
                <td class="data-table__src">{row.src}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="note-src">
          Verificamos las cargas admisibles, la geometría de la nave y el estado de la vía de
          rodadura en sitio antes de emitir los planos de fabricación.
        </p>
      </div>
    </div>
  </div>

  <div class="wrap" style="margin-top:clamp(2.5rem,5vw,4.5rem)">
    <div class="detail-pair" data-reveal-group>
      <figure data-reveal style="margin:0">
        <img
          src="/images/hoist-100t.webp"
          alt="Polipasto de cable para servicio pesado sobre fondo blanco"
          width="1700"
          height="1300"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="figcap">Polipasto de cable para servicio pesado</figcaption>
      </figure>
      <figure data-reveal style="margin:0">
        <img
          src="/images/hoist-open-winch.webp"
          alt="Conjunto de izado con tambor de cable y guías"
          width="1700"
          height="1230"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="figcap">Conjunto de izado: tambor, guías y freno</figcaption>
      </figure>
    </div>
  </div>
</section>
