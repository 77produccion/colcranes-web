---
import { CONTACT, EQUIPMENT_FAMILIES, SERVICES } from "../data/site";

const company = [
  { href: "/nosotros", label: "Nosotros y planta" },
  { href: "/proyectos", label: "Proyectos y casos de éxito" },
  { href: "/contacto", label: "Contacto y sedes" },
  { href: "/trabaje-con-nosotros", label: "Trabaje con nosotros" },
  { href: "/politica-tratamiento-datos", label: "Política de tratamiento de datos (Ley 1581)" },
];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__grid">
      <div>
        <a href="/" aria-label="COLCRANES · Inicio">
          <img
            src="/images/colcranes-logo-oscura.png"
            alt="COLCRANES · Heavy Lifting Engineering"
            width="1200"
            height="360"
            style="height:2.4rem;width:auto"
            loading="lazy"
          />
        </a>
        <p style="margin:1.25rem 0 0;max-width:34ch;font-size:.9rem;line-height:1.65">
          Diseño, fabricación, montaje y mantenimiento de sistemas de izaje para la industria colombiana.
        </p>
        <div class="site-footer__socials" style="margin-top:1.5rem">
          {CONTACT.socials.map((social) => (
            <a href={social.href} target="_blank" rel="noopener noreferrer">{social.label}</a>
          ))}
        </div>
      </div>

      <div>
        <h2><a href="/equipos">Equipos</a></h2>
        <ul>
          {EQUIPMENT_FAMILIES.map((item) => (
            <li><a href={`/equipos/${item.slug}`}>{item.pluralName}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2><a href="/servicios">Servicios</a></h2>
        <ul>
          {SERVICES.map((item) => (
            <li><a href={`/servicios/${item.slug}`}>{item.name}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2>Empresa</h2>
        <ul>
          {company.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
        <p style="margin:1.5rem 0 0;font-size:.85rem;line-height:1.7">
          Cra. 67 # Vía 40-62, piso 3<br />Barranquilla · Colombia
          <br /><br />
          Cra. 128 # 14B-31<br />Bogotá · Colombia
        </p>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="mono" style="margin:0">
        © {new Date().getFullYear()} {CONTACT.companyName} · Barranquilla · Bogotá · Cobertura nacional
      </p>
      <p class="mono" style="margin:0">
        <a href={CONTACT.salesPhoneHref}>{CONTACT.salesPhone}</a>
        &nbsp;·&nbsp;
        <a href={`mailto:${CONTACT.commercialEmail}`}>{CONTACT.commercialEmail}</a>
      </p>
    </div>
  </div>
</footer>
