---
/**
 * Escena de apertura (Hero).
 * - Reproduce en secuencia los clips optimizados de `public/videos/hero/`.
 * - Cada clip conserva su encuadre original (sin recortar el archivo): sólo se
 *   ajusta `object-position` para mantener la grúa amarilla dentro del marco.
 * - Si no hay clips, cae a la fotografía de obra propia o al espacio reservado.
 */
import { existsSync } from "node:fs";
import { responsiveImage } from "../utils/media";

const HERO_VIDEOS = [
  { src: "/videos/hero/01-hero.mp4", position: "50% 42%" },
  { src: "/videos/hero/02-planta-5mas5.mp4", position: "50% 35%" },
  { src: "/videos/hero/03-planta-amplia.mp4", position: "50% 55%" },
  { src: "/videos/hero/04-puente-cerrado.mp4", position: "50% 12%" },
  { src: "/videos/hero/05-planta-5t.mp4", position: "50% 38%" },
  { src: "/videos/hero/06-cercha-traslacion.mp4", position: "50% 12%" },
  { src: "/videos/hero/07-viga-y-traslacion.mp4", position: "50% 4%" },
  { src: "/videos/hero/08-gancho-operacion.mp4", position: "50% 10%" },
  { src: "/videos/hero/09-izaje-carga.mp4", position: "50% 12%" },
].filter((video) => existsSync(`public${video.src}`));

const hasHeroVideos = HERO_VIDEOS.length > 0;

const heroPosterWebp = existsSync("public/images/hero-video-poster.webp");
const heroPoster = heroPosterWebp
  ? "/images/hero-video-poster.webp"
  : undefined;

const heroFallbackWebp = existsSync("public/images/hero-colcranes-obra.webp");
const heroFallback = heroFallbackWebp ? "/images/hero-colcranes-obra.webp" : undefined;
---

<section class="hero" id="inicio" data-hero>
  <div class="hero__media" data-hero-media>
    {hasHeroVideos ? (
      <>
        {heroPoster && (
          <img
            class="hero__poster"
            src={heroPoster}
            {...await responsiveImage(heroPoster)}
            alt="Puente grúa amarillo Colcranes en operación dentro de una planta industrial"
            width="1920"
            height="1080"
            fetchpriority="high"
            decoding="async"
          />
        )}
        <div class="hero__videos" data-hero-videos aria-hidden="true">
          <video class="hero__video is-active" muted playsinline preload="none"></video>
          <video class="hero__video" muted playsinline preload="none"></video>
        </div>
        <ul data-hero-playlist hidden>
          {HERO_VIDEOS.map((video) => (
            <li data-src={video.src} data-mobile-src={video.src.replace(/\.mp4$/, "-mobile.mp4")} data-position={video.position}></li>
          ))}
        </ul>
      </>
    ) : heroFallback ? (
      <img
        data-hero-slide
        src={heroFallback}
        {...await responsiveImage(heroFallback)}
        alt="Obra propia de Colcranes operando en planta industrial"
        width="1920"
        height="1282"
        fetchpriority="high"
        decoding="async"
      />
    ) : (
      <div class="media-slot media-slot--hero" role="img" aria-label="Espacio reservado para video corto en bucle o fotografía de obra propia de Colcranes">
        <div class="media-slot__box">
          <span class="media-slot__tag">ESPACIO PARA VIDEO EN BUCLE O FOTO DE OBRA PROPIA</span>
          <p class="media-slot__title">Hero principal · Grúa Colcranes operando</p>
          <p class="media-slot__meta">
            Video: <code>public/videos/hero/</code> (1080 × 1920 px · 9:16 · MP4 · sin audio)<br />
            Foto / Poster: <code>public/images/hero-video-poster.webp</code> (1920 × 1080 px · 16:9 · WebP/JPG)
          </p>
        </div>
      </div>
    )}
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="wrap hero__inner">
    <span class="hero__logo-wrap">
      <img
        class="hero__logo"
        src="/images/logo-colcranes-dark-480.webp"
        alt="COLCRANES"
        width="480"
        height="144"
        decoding="async"
        data-hero-fade
      />
    </span>
    <h1 class="d1 hero__title">
      <span class="line line--small" data-hero-line><span>Equipos para</span></span>
      <span class="line" data-hero-line><span class="accent">izaje industrial.</span></span>
    </h1>

    <div class="hero__foot">
      <div>
        <p class="lede lede--light hero__summary" data-hero-fade>
          Diseño, fabricación, montaje y mantenimiento de puentes grúa, pórticos, grúas bandera y polipastos.
        </p>
        <div class="hero__ctas" data-hero-fade>
          <button class="btn btn--signal" type="button" data-quote-open>
            Solicitar cotización técnica
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path d="M5 12h14M13 5l7 7-7 7" />
            </svg>
          </button>
          <a class="btn btn--ghost-light" href="#equipos">Explorar equipos</a>
        </div>
      </div>
    </div>
  </div>
</section>
