---
import { CONTACT, EQUIPMENT_FAMILIES, SERVICES } from "../data/site";
import { responsiveImage } from "../utils/media";

const pathname = Astro.url.pathname;
const isHome = pathname === "/";

const nav = [
  { href: "/equipos", pageHref: "/equipos", label: "Equipos", index: "01", children: EQUIPMENT_FAMILIES.map((item) => ({ label: item.name, href: `/equipos/${item.slug}` })) },
  { href: "/servicios", pageHref: "/servicios", label: "Servicios", index: "02", children: [...SERVICES.map((item) => ({ label: item.name, href: `/servicios/${item.slug}` })), { label: "Estimar inspección o mantenimiento", href: "/estimador" }] },
  { href: "/proyectos", pageHref: "/proyectos", label: "Proyectos", index: "03" },
  { href: "/nosotros", pageHref: "/nosotros", label: "Nosotros", index: "04" },
  { href: "/contacto", pageHref: "/contacto", label: "Contacto", index: "05" },
];
---

<header class={`site-header ${isHome ? "" : "is-solid"}`} data-header>
  <div class="wrap">
    <div class="site-header__bar">
      <button class="menu-toggle" type="button" data-drawer-toggle aria-label="Abrir menú" aria-expanded="false" aria-controls="menu-movil">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </button>
      <a href="/" class="site-header__logo" aria-label="COLCRANES · Inicio">
        <img
          class="logo--ink"
          src="/images/colcranes-logo-oscura.webp"
          {...await responsiveImage("/images/colcranes-logo-oscura.webp", "120px")}
          alt="COLCRANES · Heavy Lifting Engineering"
          width="1200"
          height="360"
        />
        <img
          class="logo--paper"
          src="/images/colcranes-logo-clara.webp"
          {...await responsiveImage("/images/colcranes-logo-clara.webp", "120px")}
          alt=""
          aria-hidden="true"
          width="1200"
          height="360"
        />
      </a>

      <nav class="site-nav" aria-label="Navegación principal">
        {nav.map((item) => (
          <div class="nav-item" data-nav-item>
            <div class="nav-item__top">
          <a
            href={item.href}
            aria-current={pathname.startsWith(item.pageHref) && item.pageHref !== "/" ? "page" : undefined}
          >
            {item.label}
          </a>
              {item.children && (
                <button class="nav-item__toggle" type="button" aria-label={`Desplegar ${item.label.toLowerCase()}`} aria-expanded="false" aria-controls={`submenu-${item.index}`}>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                </button>
              )}
            </div>
            {item.children && (
              <ul class="nav-submenu" id={`submenu-${item.index}`}>
                <li><a class="nav-submenu__all" href={item.pageHref}>Todos los {item.label.toLowerCase()}</a></li>
                {item.children.map((child) => (
                  <li><a href={child.href} aria-current={pathname.replace(/\/$/, "") === child.href ? "page" : undefined}>{child.label}</a></li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </nav>

      <div class="site-header__actions">
        <a class="header-tel utility" href={CONTACT.salesPhoneHref} aria-label="Llamar a ventas">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M4 4h4l2 5-2.5 1.5a12 12 0 0 0 6 6L15 14l5 2v4a1 1 0 0 1-1 1A17 17 0 0 1 3 5a1 1 0 0 1 1-1Z" />
          </svg>
          Llamar
        </a>
        <button class="btn btn--signal header-cta" type="button" data-quote-open>Cotizar</button>
      </div>
    </div>
  </div>

  <div class="mobile-drawer" id="menu-movil" data-drawer data-open="false">
    <div class="mobile-drawer__inner">
      <div class="wrap">
        <nav aria-label="Navegación móvil">
          {nav.map((item) => (
            item.children ? (
              <details class="mobile-nav-group">
                <summary><span>{item.label}</span><span class="mobile-nav-group__icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></span></summary>
                <div class="mobile-nav-group__links">
                  <a href={item.pageHref}>Todos los {item.label.toLowerCase()}</a>
                  {item.children.map((child) => <a href={child.href} aria-current={pathname.replace(/\/$/, "") === child.href ? "page" : undefined}>{child.label}</a>)}
                </div>
              </details>
            ) : <a href={item.href}>
              {item.label}
              <span>{item.index}</span>
            </a>
          ))}
          <a href="#cotizar" data-quote-open>
            Cotizar proyecto
            <span>06</span>
          </a>
        </nav>
      </div>
    </div>
  </div>
</header>

<style>
  .nav-item { position: relative; }
  .nav-item__top { display: flex; align-items: center; gap: 0.25rem; }
  .nav-item__toggle {
    display: grid;
    place-items: center;
    padding: 0.5rem 0.2rem;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .nav-item__toggle svg { transition: transform 0.25s ease; }
  .nav-item[data-open="true"] .nav-item__toggle svg { transform: rotate(180deg); }
  .nav-submenu {
    position: absolute;
    top: 100%;
    left: -1.25rem;
    width: 21rem;
    max-height: calc(100dvh - 6rem);
    overflow-y: auto;
    list-style: none;
    margin: 0;
    padding: 0.6rem;
    border-top: 3px solid var(--cyan);
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 16px 36px rgb(0 0 0 / 18%);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  }
  .nav-item[data-open="true"] .nav-submenu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .nav-submenu a {
    display: block;
    padding: 0.65rem 0.8rem;
    font-size: 0.84rem;
    line-height: 1.4;
    opacity: 1;
  }
  .nav-submenu a::after { display: none; }
  .nav-submenu a:is(:hover, :focus-visible, [aria-current="page"]) {
    background: var(--steel-100);
    color: var(--navy);
  }
  .nav-submenu .nav-submenu__all {
    color: var(--navy);
    font-weight: 700;
    border-bottom: 1px solid var(--line-dark);
    margin-bottom: 0.35rem;
  }
  .mobile-nav-group summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--line-light);
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
  }
  .mobile-nav-group summary::-webkit-details-marker { display: none; }
  .mobile-nav-group__icon { display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--line-light); color: var(--cyan); }
  .mobile-nav-group summary svg { transition: transform 0.2s ease; }
  .mobile-nav-group summary:focus-visible { outline: 2px solid var(--cyan); outline-offset: 2px; }
  .mobile-nav-group summary .mobile-nav-group__page {
    flex: 1;
    padding: 0;
    border: 0;
    font: inherit;
    letter-spacing: inherit;
  }
  .mobile-nav-group[open] summary svg { transform: rotate(180deg); }
  .mobile-nav-group[data-expanded="false"] summary svg { transform: rotate(0deg); }
  .mobile-nav-group__links { padding-left: 1rem; }
  .mobile-nav-group__links a {
    font-family: inherit;
    font-size: 0.92rem;
    font-weight: 400;
    text-transform: none;
    letter-spacing: normal;
    padding-block: 0.7rem;
  }
  .mobile-drawer { max-height: calc(100dvh - 4.25rem); overflow-y: auto; }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-nav-item]").forEach((item) => {
    const toggle = item.querySelector<HTMLButtonElement>(".nav-item__toggle");
    if (!toggle) return;
    const setOpen = (open: boolean) => {
      item.dataset.open = String(open);
      toggle.setAttribute("aria-expanded", String(open));
    };
    item.addEventListener("mouseenter", () => setOpen(true));
    item.addEventListener("mouseleave", () => {
      if (!item.contains(document.activeElement)) setOpen(false);
    });
    item.addEventListener("focusin", () => setOpen(true));
    item.addEventListener("focusout", (event) => {
      if (!item.contains(event.relatedTarget as Node | null)) setOpen(false);
    });
    toggle.addEventListener("click", () => setOpen(item.dataset.open !== "true"));
    item.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        toggle.focus();
        setOpen(false);
      }
    });
    document.addEventListener("click", (event) => {
      if (!item.contains(event.target as Node)) setOpen(false);
    });
  });
</script>
